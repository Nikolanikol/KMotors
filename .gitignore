# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.env.local
.env.*.local
# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.csv

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code worktrees (служебные папки, не коммитить)
.claude/worktrees/

# Секретные ключи Google (OAuth client secret / service account) — обычно в корне репозитория
client_secret*.json
*.apps.googleusercontent.com.json
kaxis-analytics-*.json
kaxix-firebase-*.json

# Parts-image pipeline runtime artifacts
scripts/.*.log
scripts/lib/__pycache__/
_debrand_preview/
_holefix_preview/
.serena

# Промежуточные выгрузки скриптов классификации/аудита запчастей — сотни МБ,
# пересоздаются прогоном скрипта. data/skin1004.db трекается намеренно.
data/*.json

# Выгрузки аналитики и временные файлы Office (GSC/Excel экспорты кладут в корень)
*.xlsx
~$*
https___www.kmotors.shop_*/

# Служебные файлы инструментов
scratchpad_posts.json
skills-lock.json